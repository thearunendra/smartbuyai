# Copy to .env and fill in. Never commit .env.

# Google AI Studio key (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Serper.dev key for live Google Shopping prices - https://serper.dev
SERPER_API_KEY=
# Optional spare key: used automatically if the one above runs out of credits.
SERPER_API_KEY_2=

# MongoDB Atlas connection string (users + chat history + search log)
# e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend addresses allowed to call this API, comma-separated.
# Defaults to http://localhost:5173 when empty.
# e.g. CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
CORS_ORIGINS=

# Upstash Redis (REST) for the shared cache - https://console.upstash.com
# Optional: without these the cache is kept in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
